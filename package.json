{
	"name": "event-driven-simulation",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 8437 --strictPort",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1 --port 8438 --strictPort",
		"prepare": "svelte-kit sync || echo ''",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"check:architecture": "node scripts/check-architecture.mjs",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:browser": "playwright test",
		"test:browser:headed": "playwright test --headed",
		"test:browser:ui": "playwright test --ui",
		"test:browser:install": "playwright install chromium",
		"check": "npm run format:check && npm run lint && npm run check:architecture && npm run typecheck && npm run test && npm run build"
	},
	"dependencies": {
		"three": "^0.185.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"@types/three": "^0.185.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
